<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: long-cache static assets under /888 (versioned via ?v=) -->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
